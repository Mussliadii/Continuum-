# CockroachDB Cloud (Serverless, free tier) — from Cloud Console connection string
COCKROACHDB_URL=postgresql://<user>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full

# CockroachDB Managed MCP Server — service account API key (for server-to-server calls from Lambda)
COCKROACHDB_MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
COCKROACHDB_MCP_SERVICE_ACCOUNT_KEY=

# Groq API (LLM reasoning) — https://console.groq.com
GROQ_API_KEY=

# Gemini API (embeddings) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AWS (Lambda reads these from its execution role in deployment; only needed locally for testing)
AWS_REGION=us-east-1
